# ---- database ----
DATABASE_URL=postgresql+psycopg://localhost/invoice_app

# ---- Claude extraction ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The workhorse that reads every bill.
EXTRACTION_MODEL=claude-sonnet-5
EXTRACTION_EFFORT=high

# A second, independent reading by a stronger model. The arithmetic rules
# verify money but cannot verify identity — who the seller is, who the broker
# is, what the date says. Two readings agreeing is the only evidence those
# fields get. Costs roughly 0.02% of the brokerage on the same bill.
ENABLE_CROSSCHECK=true
ESCALATION_MODEL=claude-opus-5
CROSSCHECK_MIN_VALUE=1000000
CROSSCHECK_MIN_CONFIDENCE=0.90

# ---- pipeline ----
# Keep this at 1 on a 1-vCPU VPS: OCR is the CPU-heavy step.
WORKER_THREADS=2
RENDER_DPI=200
AMOUNT_TOLERANCE=1.0

# ---- business ----
DEFAULT_BROKERAGE_PCT=1.0
HOME_STATE_CODE=27

# ---- extraction backend ----
# local = read the PDF text layer + e-invoice QR, no model, no network.
# claude = send the document to the API.
EXTRACTION_BACKEND=local
