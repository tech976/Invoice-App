{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "echo 'static site: nothing to build'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/documents/:id/file", "destination": "/api/documents/:id/file.pdf" },
    { "source": "/api/:path*", "destination": "/api/:path*.json" }
  ]
}
